```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lemonade Stand: Escape the Matrix</title>
  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  <script src="https://unpkg.com/vuex@4/dist/vuex.global.prod.js"></script>
  <script src="https://unpkg.com/vue-router@4/dist/vue-router.global.prod.js"></script>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 10px; }
    .stand-section { border: 1px solid #ddd; padding: 10px; margin: 10px 0; }
    .errors { color: red; }
    .matrix-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .stand-0 { grid-area: 1 / 1; }
    .stand-1 { grid-area: 1 / 2; }
    .stand-2 { grid-area: 2 / 1; }
    .stand-3 { grid-area: 2 / 2; }
    .matrix-cell { border: 1px solid #ddd; padding: 10px; }
    .audio-player { margin-bottom: 20px; }
    .volume-control { margin-top: 10px; }
    input { width: 100%; box-sizing: border-box; margin: 5px 0; padding: 8px; font-size: 16px; }
    button { padding: 10px 20px; font-size: 16px; min-width: 44px; min-height: 44px; cursor: pointer; }
    @media (max-width: 600px) {
      .matrix-grid { grid-template-columns: 1fr; }
      .stand-0, .stand-1, .stand-2, .stand-3 { grid-area: auto; }
      h1 { font-size: 1.5em; }
      h3 { font-size: 1.2em; }
      p { font-size: 0.9em; }
      iframe { height: 120px; }
      button { width: 100%; padding: 15px; font-size: 18px; }
      input { font-size: 18px; padding: 12px; }
    }
  </style>
</head>
<body>
  <div id="app"></div>
  <script>
    const { createApp, ref, computed } = Vue;
    const { createStore } = Vuex;
    const { createRouter, createWebHistory } = VueRouter;

    const FORECASTS = [
      { label: 'Sunny', salesRange: [60, 90], chanceOfRain: 10 },
      { label: 'Cloudy', salesRange: [40, 60], chanceOfRain: 40 },
      { label: 'Storms', salesRange: [20, 40], chanceOfRain: 70 },
      { label: 'Heat Wave', salesRange: [70, 100], chanceOfRain: 5 },
      { label: 'Partly Cloudy', salesRange: [50, 70], chanceOfRain: 20 }
    ];

    const SIGN_COST = 15;
    const RAIN_PENALTY = 33;
    const STAND_SETUP_COST = 50;
    const MAX_STANDS = 4;
    const STAND_MULTIPLIERS = [0.8, 1.0, 1.0, 1.2];

    function getRandomInt(min, max) {
      min = Math.ceil(min);
      max = Math.floor(max);
      return Math.floor(Math.random() * (max - min)) + min;
    }

    const store = createStore({
      state: {
        day: 0,
        assets: 200,
        stands: [],
        errors: [],
        message: '',
        salesReport: []
      },
      mutations: {
        reset(state) {
          state.day = 0;
          state.assets = 200;
          state.stands = [{ id: 0, active: true, forecast: null, glasses: 30, signs: 2, price: 10 }];
          state.errors = [];
          state.message = '';
          state.salesReport = [];
        },
        generateForecasts(state) {
          state.stands.forEach(stand => {
            if (stand.active) {
              let idx = getRandomInt(0, FORECASTS.length);
              let forecast = { ...FORECASTS[idx] };
              forecast.chanceOfRain = Math.max(0, Math.min(100, forecast.chanceOfRain + getRandomInt(-10, 11)));
              forecast.salesRange[0] = Math.max(0, forecast.salesRange[0] + getRandomInt(-5, 6));
              forecast.salesRange[1] = Math.max(forecast.salesRange[0] + 1, forecast.salesRange[1] + getRandomInt(-5, 6));
              stand.forecast = forecast;
            }
          });
          state.message = '';
          state.day++;
        },
        buyStand(state) {
          if (state.stands.length >= MAX_STANDS || state.assets < STAND_SETUP_COST) return;
          let newId = state.stands.length;
          state.stands.push({ id: newId, active: true, forecast: null, glasses: 20, signs: 1, price: 12 });
          state.assets -= STAND_SETUP_COST;
        },
        doSales(state, salesData) {
          state.errors = [];
          let totalCost = 0;
          let validStands = [];
          salesData.forEach(data => {
            let stand = state.stands.find(s => s.id === data.standId);
            if (!stand || !stand.active) return state.errors.push(`Invalid stand ${data.standId + 1}.`);
            if (data.glasses <= 0) return state.errors.push(`Stand ${data.standId + 1}: Must make at least 1 glass.`);
            if (data.signs < 0) return state.errors.push(`Stand ${data.standId + 1}: Signs cannot be negative.`);
            if (data.price < data.costOfLemonade) return state.errors.push(`Stand ${data.standId + 1}: Price must be at least cost (${data.costOfLemonade}¢).`);
            let standCost = data.glasses * data.costOfLemonade + data.signs * SIGN_COST;
            totalCost += standCost;
            validStands.push({ ...data, standCost });
          });
          if (totalCost > state.assets) return state.errors.push(`Total expenses (${(totalCost / 100).toFixed(2)}) exceed assets (${(state.assets / 100).toFixed(2)}).`);
          if (state.errors.length > 0) return;
          state.salesReport = [];
          let totalIncome = 0;
          let rainMessages = [];
          validStands.forEach(data => {
            let stand = state.stands.find(s => s.id === data.standId);
            let range = stand.forecast.salesRange;
            let signsBonus = data.signs === 0 ? -20 : data.signs === 1 ? -10 : data.signs <= 4 ? 10 : data.signs <= 6 ? 15 : 20;
            let costBonus = data.price < 10 ? 25 : data.price < 30 ? 15 : data.price < 50 ? 10 : data.price < 75 ? 5 : data.price < 100 ? 0 : -10;
            let didItRain = getRandomInt(0, 100) < stand.forecast.chanceOfRain;
            if (didItRain) rainMessages.push(`Stand ${data.standId + 1}`);
            let percentSold = getRandomInt(range[0], range[1] + 1) + signsBonus + costBonus;
            if (didItRain) percentSold -= RAIN_PENALTY;
            percentSold = Math.max(0, Math.min(100, percentSold)) * STAND_MULTIPLIERS[data.standId];
            let glassesSold = Math.min(data.glasses, Math.floor((percentSold / 100) * data.glasses));
            let income = glassesSold * data.price;
            state.salesReport.push({ standId: data.standId, glassesSold, income, standCost: data.standCost });
            totalIncome += income;
          });
          state.assets += totalIncome - totalCost;
          if (rainMessages.length > 0) state.message = `It rained on: ${rainMessages.join(', ')}!`;
        }
      },
      getters: {
        costOfLemonade(state) { return state.day > 2 ? 4 : 2; },
        activeStands(state) { return state.stands.filter(s => s.active); },
        canBuyStand(state) { return state.stands.length < MAX_STANDS && state.assets >= STAND_SETUP_COST; },
        totalIncome(state) { return state.salesReport.reduce((sum, r) => sum + r.income, 0) / 100; },
        totalExpenses(state) { return state.salesReport.reduce((sum, r) => sum + r.standCost, 0) / 100; },
        profit(state, getters) { return getters.totalIncome - getters.totalExpenses; },
        isBankrupt(state) { return state.assets < 0; },
        isGameOver(state) { return state.day >= 10 || state.assets < 0; },
        forecastLabel: () => (f) => f ? f.label : 'N/A',
        positionLabel: () => (id) => ['Top-Left (0.8x)', 'Top-Right (1.0x)', 'Bottom-Left (1.0x)', 'Bottom-Right (1.2x)'][id] || ''
      }
    });

    const SoundCloudPlayer = {
      template: `
        <div class="audio-player">
          <iframe id="sc-widget" width="100%" height="166" scrolling="no" frameborder="no" allow="autoplay" :src="embedUrl"></iframe>
          <button @click="togglePlay">{{ isPlaying ? 'Pause' : 'Play' }}</button>
          <div class="volume-control">
            <label for="volume">Vol: {{ volume }}%</label>
            <input id="volume" type="range" v-model="volume" min="0" max="100" step="1" @input="setVolume" />
          </div>
        </div>
      `,
      data() {
        return {
          embedUrl: 'https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/davidbiga/sets/lemonade-stand&color=%23ff5500&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false',
          widget: null,
          isPlaying: false,
          volume: 50
        };
      },
      mounted() {
        const script = document.createElement('script');
        script.src = 'https://w.soundcloud.com/player/api.js';
        script.async = true;
        document.head.appendChild(script);
        script.onload = () => {
          this.widget = SC.Widget('sc-widget');
          this.widget.bind(SC.Widget.Events.PLAY, () => this.isPlaying = true);
          this.widget.bind(SC.Widget.Events.PAUSE, () => this.isPlaying = false);
          this.widget.setVolume(this.volume / 100);
        };
      },
      methods: {
        togglePlay() { if (this.widget) this.widget.toggle(); },
        setVolume() { if (this.widget) this.widget.setVolume(this.volume / 100); }
      }
    };

    const Home = {
      template: `
        <div>
          <h1>Welcome to Lemonade Stand: Escape the Matrix</h1>
          <p>Manage a 2x2 matrix of stands over 10 days to maximize profits.</p>
          <p>Enjoy tracks from the Lemonade Stand album while playing.</p>
          <router-link to="/game">Start</router-link>
        </div>
      `,
      created() { this.$store.commit('reset'); }
    };

    const Game = {
      template: `
        <div>
          <h1>Day {{ day }}: Manage Matrix</h1>
          <p>Assets: {{ (assets / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }} | Lemonade: {{ costOfLemonade }}¢ | Signs: 15¢</p>
          <div v-for="stand in activeStands" :key="stand.id" class="stand-section">
            <h3>Stand {{ stand.id + 1 }} - {{ positionLabel(stand.id) }} | Forecast: {{ forecastLabel(stand.forecast) }}</h3>
            <p>Glasses: <input type="number" v-model.number="stand.glasses" min="1" step="1" /></p>
            <p>Signs: <input type="number" v-model.number="stand.signs" min="0" step="1" /></p>
            <p>Price (¢): <input type="number" v-model.number="stand.price" :min="costOfLemonade" step="1" /></p>
          </div>
          <button v-if="canBuyStand" @click="buyStand">Buy Stand ($0.50)</button>
          <div v-if="errors.length" class="errors">
            <strong>Errors:</strong> <ul><li v-for="(e, i) in errors" :key="i">{{ e }}</li></ul>
          </div>
          <button @click="initiateSales">Run Sales</button>
        </div>
      `,
      computed: {
        day() { return this.$store.state.day; },
        assets() { return this.$store.state.assets; },
        errors() { return this.$store.state.errors; },
        activeStands() { return this.$store.getters.activeStands; },
        canBuyStand() { return this.$store.getters.canBuyStand; },
        costOfLemonade() { return this.$store.getters.costOfLemonade; },
        forecastLabel() { return this.$store.getters.forecastLabel; },
        positionLabel() { return this.$store.getters.positionLabel; }
      },
      created() { if (this.day === 0) this.$store.commit('generateForecasts'); },
      methods: {
        buyStand() {
          this.$store.commit('buyStand');
          this.$store.commit('generateForecasts');
        },
        initiateSales() {
          const salesData = this.activeStands.map(s => ({
            standId: s.id,
            glasses: s.glasses,
            signs: s.signs,
            price: s.price,
            costOfLemonade: this.costOfLemonade
          }));
          this.$store.commit('doSales', salesData);
          if (!this.errors.length) this.$router.push('/report');
        }
      }
    };

    const Report = {
      template: `
        <div>
          <h1>Day {{ day }} Report</h1>
          <p v-if="message"><strong>{{ message }}</strong></p>
          <div class="matrix-grid">
            <div v-for="r in salesReport" :key="r.standId" :class="\`matrix-cell stand-\${r.standId}\`">
              <h3>Stand {{ r.standId + 1 }} ({{ positionLabel(r.standId) }})</h3>
              <p>Sold: {{ r.glassesSold }}</p>
              <p>Income: {{ (r.income / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }}</p>
              <p>Expenses: {{ (r.standCost / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }}</p>
            </div>
          </div>
          <p>Total Income: {{ totalIncome.toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }} | Expenses: {{ totalExpenses.toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }} | Profit: {{ profit.toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }}</p>
          <p>Assets: {{ (assets / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }}</p>
          <div v-if="isGameOver">
            <h2>Game Over! Assets: {{ (assets / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) }}</h2>
            <p v-if="assets >= 1000">High Score! License via NovelistMusicGroup.com.</p>
            <p v-else-if="assets >= 500">Solid Effort.</p>
            <p v-else>Bankrupt - Retry.</p>
            <router-link to="/">Again</router-link>
          </div>
          <router-link v-else to="/game">Next</router-link>
        </div>
      `,
      computed: {
        day() { return this.$store.state.day; },
        assets() { return this.$store.state.assets; },
        message() { return this.$store.state.message; },
        salesReport() { return this.$store.state.salesReport; },
        totalIncome() { return this.$store.getters.totalIncome; },
        totalExpenses() { return this.$store.getters.totalExpenses; },
        profit() { return this.$store.getters.profit; },
        isGameOver() { return this.$store.getters.isGameOver; },
        positionLabel() { return this.$store.getters.positionLabel; }
      },
      created() {
        if (this.day === 0 || !this.salesReport.length) this.$router.push('/');
        if (!this.isGameOver) this.$store.commit('generateForecasts');
      }
    };

    const routes = [
      { path: '/', component: Home },
      { path: '/game', component: Game },
      { path: '/report', component: Report }
    ];

    const router = createRouter({
      history: createWebHistory(),
      routes
    });

    const app = createApp({
      components: { 'sound-cloud-player': SoundCloudPlayer }
    });
    app.use(router);
    app.use(store);
    app.mount('#app');
  </script>
</body>
</html>
